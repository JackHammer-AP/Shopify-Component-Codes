{% schema %}
{
  "name": "Custom Marquee",
  "class": "infinite-scroll-section",
  "blocks": [
    {
      "type": "text",
      "name": "Text Block",
      "settings": [
        {
          "type": "text",
          "id": "block_text",
          "label": "Block Text",
          "default": "Free shipping on all orders"
        },
        {
          "type": "color",
          "id": "block_text_color",
          "label": "Block Text Color",
          "default": "#ffffff"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "Scroll Speed",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 5
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font Size",
      "min": 12,
      "max": 28,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "text_gap",
      "label": "Gap",
      "min": 0,
      "max": 60,
      "step": 1,
      "default": 6,
      "unit": "rem"
    },
    {
      "type": "select",
      "id": "separator_type",
      "label": "Separator Icon",
      "options": [
        { "value": "star", "label": "Star" },
        { "value": "sun", "label": "Sun" },
        { "value": "party-popper", "label": "Popper" }
      ],
      "default": "star"
    },
    {
      "type": "color",
      "id": "separator_color",
      "label": "Separator Icon Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Custom Marquee",
      "category": "Custom",
      "blocks": [
        {
          "type": "text"
        },
        {
          "type": "text"
        },
        {
          "type": "text"
        }
      ]
    }
  ]
}
{% endschema %}

<style>
  .header {
    margin-top: calc({{ section.settings.font_size }}px + 20px); /* font size + padding */
  }
  
   .infinite-scroll-container {
    position: fixed;
    top: 0;
    z-index: 9999;
    width: 100%;
    overflow: hidden;
    background-color: {{ section.settings.background_color }};
    padding: 10px 0;
    line-height: var(--body-line-height, calc(1 + 0.71428 / var(--body-font-scale)));
  }

   .infinite-scroll-wrapper {
    display: flex;
    justify-content: space-evenly;
    white-space: nowrap;
    gap: {{section.settings.text_gap}}rem;
  }

   .infinite-scroll-block {
    display: flex;
    align-items: center;
    /* justify-content: center; */
    font-size: {{ section.settings.font_size }}px;
    gap: {{section.settings.text_gap}}rem;
    letter-spacing: 1px;
  }

   .infinite-scroll-group {
    display: flex;
    animation: scroll-blocks linear infinite;
    animation-duration: calc(120s / {{ section.settings.scroll_speed }}); /* Adjust speed based on setting */
    /* width: 100%; */
    gap: {{section.settings.text_gap}}rem;
    text-transform: uppercase;
  }

  @keyframes scroll-blocks {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-100% - {{section.settings.text_gap}}rem));
    }
  }

  /* Star Seperator Styles  */

   .star-separator {
    font-size: 14px !important;
    display: flex;
    align-items: center;
    padding: 0 1rem;
    color: {{section.settings.separator_color}};
  }

  /* Sun Seperator Styles */

   .boho-icon {
    animation: rotateBoho 8s linear infinite;
    display: block;
    color: {{section.settings.separator_color}}; /* Adjust if you use a different theme color */
  }

  @keyframes rotateBoho {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(270deg);
    }
  }

   .sun-separator {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 1rem;
  }

  /* Party Popper styles */
  .party-popper {
    display: block;
    animation: popWiggle 3s ease-in-out infinite;
    font-size: {{ section.settings.font_size}}px !important;
  }

  @keyframes popWiggle {
    0%, 100% {
      transform: rotate(0deg);
    }
    25% {
      transform: rotate(5deg);
    }
    75% {
      transform: rotate(-5deg);
    }
  }

  @media screen and (max-width: 767px) {
    .infinite-scroll-block {
      font-size: calc({{ section.settings.font_size }}px * 0.9);
      letter-spacing: 1px;
    }
  }
</style>

<div class="infinite-scroll-container" id="infinite-scroll-{{ section.id }}">
  <div class="infinite-scroll-wrapper" id="scroll-wrapper-{{ section.id }}">
    {% for i in (1..5) %}
      <div class="infinite-scroll-group" id="scroll-group-{{ section.id }}-{{ i }}">
        {% for block in section.blocks %}
          <div
            class="infinite-scroll-block"
            style="color: #FFFFFF !important;"
          >
            {{ block.settings.block_text }}

            <div
              class="infinite-scroll-block"
              aria-hidden="true"
              style="color: {{ section.settings.separator_color }}"
            >
              {% if section.settings.separator_type == 'star' %}
                <div class="star-seperator">✦</div>
              {% elsif section.settings.separator_type == 'sun' %}
                <svg
                  class="boho-icon sun-seperator"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2" fill="none"/>
                  <g stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="2" x2="12" y2="6"/>
                    <line x1="12" y1="18" x2="12" y2="22"/>
                    <line x1="2" y1="12" x2="6" y2="12"/>
                    <line x1="18" y1="12" x2="22" y2="12"/>
                    <line x1="4.2" y1="4.2" x2="6.8" y2="6.8"/>
                    <line x1="17.2" y1="17.2" x2="19.8" y2="19.8"/>
                    <line x1="17.2" y1="6.8" x2="19.8" y2="4.2"/>
                    <line x1="4.2" y1="19.8" x2="6.8" y2="17.2"/>
                  </g>
                </svg>
              {% elsif section.settings.separator_type == 'party-popper' %}
                <div class="party-popper">🎉</div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% endfor %}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    function adjustScrollerWidth() {
      const scrollWrapper = document.getElementById('scroll-wrapper-{{ section.id }}');
      const scrollGroup = document.getElementById('scroll-group-{{ section.id }}-1');
      
      if (!scrollGroup) return;
      
      // Check if the first group is enough to cover the screen
      const groupWidth = scrollGroup.offsetWidth;
      const screenWidth = window.innerWidth;
      
      // Calculate how many repetitions needed to fill at least twice the screen width
      const requiredRepetitions = Math.ceil(screenWidth * 2 / groupWidth);
      
      // Get current number of groups
      const currentGroups = scrollWrapper.querySelectorAll('.infinite-scroll-group').length;
      
      // Add more groups if needed
      if (requiredRepetitions > currentGroups) {
        const originalGroup = scrollGroup.cloneNode(true);
        
        for (let i = currentGroups; i < requiredRepetitions; i++) {
          const newGroup = originalGroup.cloneNode(true);
          newGroup.id = `scroll-group-{{ section.id }}-${i + 1}`;
          scrollWrapper.appendChild(newGroup);
        }
      }
    }
    
    // Run once on load and whenever the window resizes
    adjustScrollerWidth();
    window.addEventListener('resize', adjustScrollerWidth);
  });
</script>
